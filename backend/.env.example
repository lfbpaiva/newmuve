# Copie para backend/.env apenas no desenvolvimento. No Render, configure no painel.
# As chaves abaixo permanecem exclusivamente no backend.

# Supabase: use a URL HTTPS do projeto e as chaves correspondentes.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Escolha explicitamente sandbox ou production. A URL deve corresponder ao ambiente.
# No Render preparado nesta etapa, mantenha sandbox; não use chave de produção.
ASAAS_ENV=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Em produção, informe apenas origens HTTPS do frontend web, separadas por vírgula.
# Desenvolvimento: localhost:8443 (React) e localhost:8081 (Expo web).
# O app nativo não envia Origin. Nunca use *.
ALLOWED_ORIGINS=http://localhost:8443,http://localhost:8081
ALLOWED_REDIRECTS=muve://auth
# URL pública do frontend usada pelo processo financeiro nas notificações existentes.
APP_URL=http://localhost:8443

# Render define PORT automaticamente. O servidor escuta em 0.0.0.0.
PORT=3333
# IPs de proxies reversos confiáveis, se necessário.
TRUSTED_PROXY_IPS=

# SMTP opcional; sem host os avisos são registrados pelo servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Muve <no-reply@seudominio.com>"

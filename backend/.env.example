# Copie para backend/.env (nunca versionado) e preencha.
# Em produção, defina estas variáveis no provedor de hospedagem.

# Supabase: Dashboard > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon)
SUPABASE_ANON_KEY=
# Chave secreta (secret/service_role): ignora o RLS. NUNCA usar no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas: sandbox por padrão. Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Mesmo valor cadastrado como "token de autenticação" no webhook da Asaas.
ASAAS_WEBHOOK_TOKEN=

# Origens autorizadas (CORS), separadas por vírgula: o app Expo no navegador (8081).
# O app nativo não envia Origin, então não depende desta lista.
ALLOWED_ORIGINS=http://localhost:8081
PORT=3333

# Com NODE_ENV=production (já definido em "pnpm start:api"), a API não libera CORS
# automaticamente para os IPs desta máquina: só valem as origens de ALLOWED_ORIGINS.
# NODE_ENV=production

# IPs de proxies reversos confiáveis (separados por vírgula). O limite de tentativas usa
# o IP da conexão; X-Forwarded-For só é lido quando a conexão vem de um destes IPs
# (127.0.0.1 e ::1 já são confiáveis). Deixe vazio se a API não estiver atrás de proxy.
TRUSTED_PROXY_IPS=

# E-mails de aviso (aprovação, pagamento, desistência). Opcional: sem SMTP,
# os avisos só aparecem no log. Pode ser o mesmo provedor usado no Supabase Auth.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Muve <no-reply@seudominio.com>"

# Destinos extras para os links de confirmação e redefinição de senha: o app instalado (muve://)
# e o Expo Go (exp://, com * no fim para aceitar qualquer IP). O app no navegador usa ALLOWED_ORIGINS + /auth.
ALLOWED_REDIRECTS=muve://auth,exp://*

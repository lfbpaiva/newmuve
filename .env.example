# Copie para .env.local e preencha. Variáveis VITE_* são públicas.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Desenvolvimento: /api passa pelo proxy Vite para localhost:3333.
# Web hospedada: use https://SEU-SERVICO.onrender.com/api,
# ou /api se o host web tiver um proxy reverso configurado.
VITE_API_URL=/api

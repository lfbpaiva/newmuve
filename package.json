    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "node scripts/e2e-api.mjs run",
    "format": "oxfmt"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "nodemailer": "^10.0.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.5",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.18"
  }

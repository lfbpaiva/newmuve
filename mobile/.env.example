# Copie para mobile/.env. Variáveis EXPO_PUBLIC_* são públicas e entram no bundle.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA

# Dispositivo físico no Wi-Fi local: http://IP_DO_COMPUTADOR:3333/api
# Emulador Android: http://10.0.2.2:3333/api
# Simulador iOS ou Expo web local: http://localhost:3333/api
# App distribuído: https://SEU-SERVICO.onrender.com/api
# Sem esta variável, apenas o modo de desenvolvimento tenta detectar o host do Expo.
# EXPO_PUBLIC_API_URL=http://IP_DO_COMPUTADOR:3333/api

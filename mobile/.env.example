# Copie para mobile/.env. Valores públicos (vão para o app).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Opcional em desenvolvimento: sem ela, o app usa o endereço da máquina que roda o Expo.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333/api
# Opcional: chave do site do Cloudflare Turnstile. Sem ela, o app não mostra a verificação anti-robô.
# Com ela, ative o mesmo captcha no Supabase (Authentication > Attack Protection).
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Domínio usado pelo Turnstile no celular; precisa estar na lista de domínios do widget na Cloudflare.
# EXPO_PUBLIC_TURNSTILE_BASE_URL=https://SEU-PROJETO.supabase.co
